class_name QuestGenerator
extends RefCounted

static func build_expansion_prompt(quest) -> String:
	var stage_name = ""
	var specific_stage_rules = ""

	if quest.campaign_stage == "climax":
		stage_name = "ФИНАЛ (Кульминация и Развязка)"
		specific_stage_rules = """ЭТАП: ФИНАЛ И РАЗВЯЗКА КАМПАНИИ.
- Сгенерируй кульминационную локацию (например, центральный пункт побега, ангар, рубка управления, зал трибунала).
- Здесь игрок МОЖЕТ окончательно выиграть или трагически погибнуть.
- Обязательно добавь действия с "is_ending": true, "victory": true (при выполнении условий/наличии предметов) и с "is_ending": true, "victory": false (смертельная ошибка).
- Все сюжетные нити должны сойтись воедино!"""
	else:
		stage_name = "Глава 2." + str(quest.current_chapter) + " (Развитие сюжета)"
		specific_stage_rules = """ЭТАП: ОСНОВНАЯ ЧАСТЬ (Глава 2.""" + str(quest.current_chapter) + """).
- Игрок продвигается вглубь неизведанной территории. Не давай финал прямо сейчас!
- Поставь перед игроком сложную промежуточную цель: добыть ключ, обойти патруль, починить генератор, выведать тайну у NPC.
- Создай опасные развилки. Если игрок действует неосторожно — предусмотрены суровые последствия ("damage_hp": 25-40).
- Предусмотри 1 ключевую сюжетную улику/зацепку (отметь в описании как [важно: ...])."""

	return """Ты — ведущий сценарист и геймдизайнер текстовых RPG экстра-класса (уровня 'Fallout 2', 'Космические рейнджеры', 'Disco Elysium').
Сгенерируй продолжение кампании: """ + stage_name + """.
Текущая позиция игрока: \"""" + quest.current_location + """\".
Уже посещено: """ + ", ".join(quest.visited_locations) + """.
Инвентарь игрока: """ + (", ".join(quest.inventory) if quest.inventory.size() > 0 else "пусто") + """.
Сеттинг: """ + quest.active_setting_text + """

СТИЛЬ И ТРЕБОВАНИЯ К ТЕКСТУ:
1. Пиши богатым, живым литературным языком без клише, сухости и канцелярита.
2. В каждом описании ("desc") — ровно 2 содержательных абзаца с физическими деталями (освещение, запахи, звуки, следы событий).
3. Каждое действие ("scripted_actions") ОБЯЗАНО иметь прописанный литературный результат в "narration" (2 абзаца).
4. Одноразовые предметы (ключи, батареи, отмычки) должны списываться при использовании: "consume_item": true.
5. Сущности размечай тегами: [предмет: Название], [локация: Название], [персонаж: Имя], [важно: Улика]. Названия в inventory_add и inventory_remove пиши БЕЗ тегов!

""" + specific_stage_rules + """

ОТВЕТ СТРОГО В PURE JSON (без markdown-обёрток):
{
  "world_graph": {
    \"""" + quest.current_location + """\": {
      "connections": ["Новая Локация 1"],
      "scripted_actions": []
    },
    "Новая Локация 1": {
      "desc": "Литературное описание локации в 2 абзаца...",
      "connections": [\"""" + quest.current_location + """\", "Новая Локация 2"],
      "scripted_actions": [
        {
          "text": "Осмотреть старый терминал",
          "preview": "Изучить логи связи",
          "narration": "Подробный художественный результат действия в 2 абзаца...",
          "requires": "",
          "consume_item": false,
          "inventory_add": [],
          "is_ending": false,
          "victory": false,
          "once": true
        }
      ]
    }
  }
}"""